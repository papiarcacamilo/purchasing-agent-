# Copia este archivo a ".env" y completa los valores:
#   cp .env.example .env
# El archivo .env está en .gitignore: nunca lo subas al repositorio
# ni pegues la clave en el código, el README o la memoria del proyecto.

# === OpenAI (OBLIGATORIO) ===
OPENAI_API_KEY=sk-...
# Debe ser un modelo que soporte Structured Outputs (json_schema estricto).
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0

# === LangSmith (OPCIONAL: trazabilidad del grafo) ===
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cotizador-compras
